SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Required for the starfield to color/cluster by genre.
# Spotify removed `genres` from /artists/{id} in 2026, so we fall back to Last.fm.
# Get a free key in 30 seconds: https://www.last.fm/api/account/create
LASTFM_API_KEY=
