SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Optional but STRONGLY recommended for showcase mode.
# When set, Lyra runs OAuth as a confidential client: refresh tokens issued
# by Spotify won't rotate on every use, so SHOWCASE_REFRESH_TOKEN stays
# valid across server restarts and Vercel cold starts.
# Without this, Spotify's PKCE flow rotates the refresh token on every
# refresh and the env var goes stale within hours.
# Get it from your Spotify app dashboard → "View client secret".
SPOTIFY_CLIENT_SECRET=

# Required for the starfield to color/cluster by genre.
# Spotify removed `genres` from /artists/{id} in 2026, so we fall back to Last.fm.
# Get a free key in 30 seconds: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# --- Showcase mode (optional) ---
# Lets unauthenticated visitors see the site owner's now-playing / recently
# played / top artists, sourced via a stored refresh token. Without this,
# anonymous home page reads return empty state.
#
# To set it: run the regular Spotify login flow against your own account,
# then copy the value of the `spotify_refresh` cookie (browser devtools →
# Application → Cookies → 127.0.0.1) into the var below.
SHOWCASE_REFRESH_TOKEN=

# Used by /api/cron/refresh-showcase to authorize Vercel's cron caller.
# Set to any random string; configure the same value in Vercel project
# settings → Cron Jobs → Authorization header. Leave empty in dev.
CRON_SECRET=

# Vercel Blob token for the library showcase snapshot. When set, the
# "Refresh showcase" button on /library publishes the JSON to Vercel
# Blob; without it, the JSON is written to public/showcase-library.json
# (fine for local dev; on Vercel the public/ folder is read-only at
# runtime, so the Blob token is required for prod).
# Set up: Vercel Dashboard → Storage → Create Database → Blob → connect
# to project. Vercel injects this var automatically; for local dev,
# `vercel env pull` copies it into .env.local.
BLOB_READ_WRITE_TOKEN=
