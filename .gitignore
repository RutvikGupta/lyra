# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep .env.example as a template, ignore everything else
.env*
!.env.example

# vercel
.vercel

# Showcase + share snapshots — these are baked at runtime and live in
# Vercel Blob in production. The local `public/` files are dev-only
# scratch space; committing them would leak personal listening history.
/public/showcase-library.json
/public/shares/

# Personal-data fixture generated from a user's Spotify export. The
# small synthetic /fixtures/Apple Music Play Activity.csv stays
# committed for parser tests, but the full conversion of someone's
# real history must not.
/fixtures/Apple Music Play Activity (from Spotify).csv

# typescript
*.tsbuildinfo
next-env.d.ts
